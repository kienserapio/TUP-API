{
  "name": "tup-open-api",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "capture": "pnpm --filter @tup/ingest capture",
    "db:migrate": "pnpm --filter @tup/db migrate",
    "db:reset": "pnpm --filter @tup/db reset",
    "db:seed": "pnpm --filter @tup/db seed",
    "dev": "pnpm --filter @tup/api dev",
    "format": "prettier --write .",
    "gates": "./scripts/ci-gates.sh",
    "ingest": "pnpm --filter @tup/ingest ingest",
    "ingest:decay": "pnpm --filter @tup/ingest decay",
    "ingest:replay": "pnpm --filter @tup/ingest replay",
    "ingest:unmatched": "pnpm --filter @tup/ingest unmatched",
    "lint": "eslint .",
    "openapi:generate": "pnpm --filter @tup/api openapi:generate",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:contract": "vitest run --project contract",
    "test:fixtures": "vitest run --project fixtures",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm gates && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tup/adapters": "workspace:*",
    "@tup/core": "workspace:*",
    "@tup/db": "workspace:*",
    "@tup/schemas": "workspace:*",
    "@types/node": "^26.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
