# ── Local development ────────────────────────────────────────────
# Local Docker Postgres 17 + pgvector. See docs/15-local-development.md
DATABASE_URL=postgresql://postgres:dev@localhost:5432/tup
DATABASE_URL_POOLED=postgresql://postgres:dev@localhost:5432/tup
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# 'fixtures' | 'live'. NEVER 'live' locally — docs/15 §1
FETCH_MODE=fixtures

